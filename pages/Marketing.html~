<script>
    function showpage(pageId) {
        // 1. Hide all pages
        document.querySelectorAll('.page').forEach(page => {
            page.style.display = "none";
        });

        // 2. Remove 'active' class from all sidebar navigation items
        document.querySelectorAll('.sidebar .nav-item').forEach(item => {
            item.classList.remove('active');
        });

        // 3. Show the selected page
        const page = document.getElementById(pageId);
        if (!page) return;

        if (pageId === "logout") {
            page.style.display = "flex";
        } else {
            page.style.display = "block";
        }

        // 4. Update the active CSS class in the sidebar
    const activeNavItem = document.querySelector(`.sidebar .nav-item[onclick*="'${pageId}'"]`);
    if (activeNavItem) {
        activeNavItem.classList.add('active');
    }

    // 5. Automatically reload data & reset filters for Marketing screens
    if (pageId === "page1" && typeof loadMarketingDashboard === "function") {
        loadMarketingDashboard(); // Dashboard Overview
    } else if (pageId === "Enquiry" && typeof loadEnquiries === "function") {
        fetchEnquiryData(); // Customer Enquiries
    } else if (pageId === "page3" && typeof loadOrdersAndKPIs === "function") {
        loadOrdersAndKPIs(); // Orders
    }

        // 5. Save current page in URL hash and localStorage
        if (pageId !== "logout") {
            window.location.hash = pageId;
            localStorage.setItem("activePage", pageId);
        }
    }

    // Function to restore active page on Page Refresh or URL direct access
    function restoreActivePage() {
        // Priority 1: Check if there's a hash in the URL (e.g., #page3)
        let hashPage = window.location.hash.replace("#", "");

        // Priority 2: Check localStorage if no URL hash exists
        if (!hashPage) {
            hashPage = localStorage.getItem("activePage");
        }

        // Priority 3: Fallback to default page1 (Dashboard)
        if (!hashPage || !document.getElementById(hashPage)) {
            hashPage = "page1";
        }

        showpage(hashPage);
    }

    function getActiveUserId() {
        const urlParams = new URLSearchParams(window.location.search);
        const hiddenInput = document.getElementById("session_admin_id");

        const userId =
            (hiddenInput ? hiddenInput.value : "") ||
            urlParams.get("user_id") ||
            urlParams.get("admin_id") ||
            urlParams.get("id") ||
            localStorage.getItem("user_id") ||
            localStorage.getItem("admin_id") ||
            sessionStorage.getItem("user_id") ||
            sessionStorage.getItem("admin_id");

        if (userId && userId.trim() !== "" && userId !== "null" && userId !== "undefined") {
            return userId.trim();
        }
        return null;
    }

    document.addEventListener("DOMContentLoaded", function() {
        // Restore active page state on refresh
        restoreActivePage();

        const currentUserId = getActiveUserId();
        if (currentUserId) {
            const hiddenField = document.getElementById('session_admin_id');
            if (hiddenField) hiddenField.value = currentUserId;

            localStorage.setItem('user_id', currentUserId);
            sessionStorage.setItem('user_id', currentUserId);
        }
    });

    // Handle browser back/forward buttons
    window.addEventListener("hashchange", function() {
        restoreActivePage();
    });

    const urlParams = new URLSearchParams(window.location.search);
    const currentUserId = urlParams.get('user_id') || urlParams.get('admin_id');

    if (!currentUserId || currentUserId.trim() === "") {
        alert("Session invalid or User ID missing. Please log in again.");
        window.location.href = "/techvoltInstituteProject/pages/login.html";
    } else {
        const userField = document.getElementById('user_id_input');
        if (userField) {
            userField.value = currentUserId.trim();
        }
    }
</script>

