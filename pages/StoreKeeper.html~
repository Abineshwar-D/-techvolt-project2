    <!-- ==================== SCREEN 3: ADD MATERIAL ==================== -->
    <section id="AddMaterial" class="page" style="display: none;">
        <div class="page-header">
            <div>
                <nav class="breadcrumb-custom">
                    <span>Inventory</span>
                    <i class="bi bi-chevron-right"></i>
                    <span class="current">Add New Material</span>
                </nav>
                <h2 class="page-title">Material Registration</h2>
            </div>
        </div>

        <div class="form-scroll custom-scrollbar">
            <div class="row g-4">
                <div class="col-lg-13">
                    <form action="../py/inventory/add_material.py" method="post" id="material_form">
                        <input type="hidden" name="user_id" id="user_id_input">

                        <div class="form-card">
                            <div class="card-header">
                                <i class="bi bi-plus-circle"></i>
                                <h5>Material Specification</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label class="form-label-custom">Purchase Order</label>
                                        <select class="form-select-custom" name="purchase_order" id="purchaseOrder" required>
                                            <option selected>select option</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label-custom">Material Name <span class="required">*</span></label>
                                        <input type="text" class="form-control-custom" value="" name="material_name" id="materialName" minlength="3" maxlength="30" required readonly>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Category</label>
                                        <select class="form-select-custom" name="category" required>
                                            <option selected>Yarn</option>
                                            <option>Dye</option>
                                            <option>Chemical</option>
                                            <option>Packaging Material</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Unit of Measurement</label>
                                        <select class="form-select-custom" name="unit" required>
                                            <option selected>Kg</option>
                                            <option>Cone</option>
                                            <option>Roll</option>
                                            <option>Box</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Opening Stock</label>
                                        <div class="input-with-suffix">
                                            <input type="number" class="form-control-custom" value="" name="opening_stock" id="openingStock" required min="0" step="0.01" readonly>
                                            <span class="suffix">KG</span>
                                        </div>
                                    </div>

                                     <div class="col-md-6">
                                        <label class="form-label-custom">Supplier</label>
                                        <div class="input-with-suffix">
                                            <input type="text" class="form-control-custom" value="" name="supplier" id="supplierInput" required min="0" step="0.01" readonly>
                                        </div>
                                    </div>

                                     <div class="col-md-6">
                                        <label class="form-label-custom">Manufacturing Date <span class="required">*</span></label>
                                        <input type="date" class="form-control-custom" value="" name="manufacturing_date" id="manufacturing_date" required>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label-custom">Description</label>
                                        <textarea class="form-control-custom" rows="3" placeholder="Enter additional material notes here..." name="description"></textarea>
                                    </div>

                                    <div class="action-buttons d-flex gap-2">
                <button class="btn btn-outline-secondary px-4 py-2 rounded-3">Cancel</button>
                <button class="btn btn-secondary px-4 py-2 rounded-3 d-flex align-items-center gap-2" type="submit" form="material_form">
                    <i class="bi bi-save"></i>
                    Save Material
                </button>
            </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="toast-custom" id="SuccessAddMatrial">
