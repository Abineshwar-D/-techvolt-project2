            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-13">
                <form action="../py/orders/save_order.py" method="post" id="orderForm">
                    <input type="hidden" name="customer_id" id="customerId">
<!--                    TO PASS USER ID-->
                    <input type="hidden" name="user_id" id="user_id_input">

                    <div class="form-card">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom">Customer</label>
                                <select class="form-control-custom" id="customerSelect" name="customer" required></select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Customer Contact</label>
                                <input type="text" class="form-control-custom" id="customerContact" value="" name="contact" required minlength="10" maxlength="10" pattern="[6-9][0-9]{9}" readonly>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">fabric type</label>
                                <input type="text" class="form-control-custom" id="fabric_type" name="fabric_type" required minlength="10" maxlength="10" pattern="[6-9][0-9]{9}" readonly>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Color</label>
                                <div class="d-flex gap-2">
                                    <input type="text" class="form-control-custom" value="Blue" id="colorInput" name="color" required minlength="3" maxlength="30" pattern="[A-Za-z ]+" readonly>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Order Quantity</label>
                                <div class="position-relative">
                                    <input type="number" class="form-control-custom with-icon fw-bold text-secondary" id="quantity1" value="0" name="quantity" required min="1" step="0.01" readonly>
                                    <span class="input-suffix">Kg</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Price Per Kg</label>
                                <div class="position-relative">
                                    <span class="input-icon"><i class="bi bi-currency-rupee"></i></span>
                                    <input type="number" class="form-control-custom with-icon" id="price" value="0" oninput="calculateTotal()" name="price" required min="1" step="0.01" readonly>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Payment Percentage</label>
                                <div class="position-relative">
                                    <input type="number" class="form-control-custom with-icon fw-bold text-secondary" id="percentage" value="0" name="percentage" required min="1" step="0.01" readonly>
                                    <span class="input-suffix">%</span>
                                </div>
                            </div>

                           <div class="col-12">
    <div class="total-box">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <div class="total-label">Total Estimated Amount</div>
                <div class="total-amount" id="totalAmounts">₹0</div>
            </div>
            <!-- Added Balance Display -->
            <div>
                <div class="total-label">Balance Amount (50%)</div>
                <div class="total-amount" id="balanceAmount">₹0</div>
            </div>
            <div class="total-note">*Calculated based on Qty x Price</div>
        </div>
    </div>
</div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Required Delivery Date</label>
                                <input type="date" class="form-control-custom border border-secondary" value="" name="delivery_date" id="delivery_date" required>
                            </div>

                            <div class="col-6">
                                <label class="form-label-custom">Money Transition</label>
                                <div class="radio-group-custom">
                                    <label class="radio-item"><input type="radio" name="money" value="UPI"><span>UPI</span></label>
                                    <label class="radio-item"><input type="radio" name="money" value="Cash"><span>Cash</span></label>
                                    <label class="radio-item"><input type="radio" name="money" value="Card" checked><span class="label-high">Card</span></label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label-custom">Special Remarks</label>
                                <textarea class="form-control-custom" rows="3" placeholder="Enter any specific requirements for production or dyeing..." name="remarks" maxlength="500"></textarea>
                            </div>
                        </div>

                          <div class="d-flex gap-2 mt-5 mt-md-0">
                <button class="btn btn-outline-secondary px-4 py-2 rounded-3">Cancel</button>
                <button class="btn btn-secondary px-4 py-2 rounded-3 d-flex align-items-center gap-2" form="orderForm" type="submit">
                    <i class="bi bi-save"></i> Save Order
                </button>
            </div>

                    </div>
