<script>
     function showpage(pageId) {
        // 1. Hide all pages
        document.querySelectorAll('.page').forEach(page => {
            page.style.display = "none";
        });

        // 2. Remove 'active' class from all sidebar navigation items
        document.querySelectorAll('.sidebar .nav-item').forEach(item => {
            item.classList.remove('active');
        });

        // 3. Show the selected page
        const page = document.getElementById(pageId);
        if (!page) return;

        if (pageId === "logout") {
            page.style.display = "flex";
        } else {
            page.style.display = "block";
        }

         // 4. Update active CSS class in sidebar
    const activeNavItem = document.querySelector(`.sidebar .nav-item[onclick*="'${pageId}'"]`);
    if (activeNavItem) {
        activeNavItem.classList.add('active');
    }

    // 5. Reload data & reset filters for StoreKeeper screens
    if (pageId === "Store" && typeof loadStoreInventory === "function") {
        loadStoreInventory(); // Storekeeper Dashboard
    } else if (pageId === "page6" && typeof loadMaterialsAndKPIs === "function") {
        loadMaterialsAndKPIs(); // Inventory
    } else if (pageId === "page4" && typeof loadSuppliersAndKPIs === "function") {
        loadSuppliersAndKPIs(); // Suppliers
    } else if (pageId === "page5" && typeof refreshAllData === "function") {
        refreshAllData(); // Purchase Orders
    }

        // 5. Save current page in URL hash and localStorage
        if (pageId !== "logout") {
            window.location.hash = pageId;
            localStorage.setItem("activePage", pageId);
        }
    }

    // Function to restore active page on Page Refresh or URL direct access
    function restoreActivePage() {
        // Priority 1: Check if there's a hash in URL (e.g., #page6)
        let hashPage = window.location.hash.replace("#", "");

        // Priority 2: Check localStorage if no URL hash exists
        if (!hashPage) {
            hashPage = localStorage.getItem("activePage");
        }

        // Priority 3: Fallback to default "Store" dashboard
        if (!hashPage || !document.getElementById(hashPage)) {
            hashPage = "Store";
        }

        showpage(hashPage);
    }

    function getActiveUserId() {
        const urlParams = new URLSearchParams(window.location.search);

        const userId =
            urlParams.get("user_id") ||
            urlParams.get("admin_id") ||
            urlParams.get("id") ||
            localStorage.getItem("user_id") ||
            localStorage.getItem("admin_id") ||
            sessionStorage.getItem("user_id") ||
            sessionStorage.getItem("admin_id");

        if (userId && userId.trim() !== "" && userId !== "null" && userId !== "undefined") {
            return userId.trim();
        }
        return null;
    }

    // Session validation and page state restoration
    const currentUserId = getActiveUserId();

    if (!currentUserId || currentUserId.trim() === "") {
        alert("Session invalid or User ID missing. Please log in again.");
        window.location.href = "/techvoltInstituteProject/pages/login.html";
    } else {
        localStorage.setItem('user_id', currentUserId);
        sessionStorage.setItem('user_id', currentUserId);

        document.addEventListener("DOMContentLoaded", function () {
            // Populate hidden form user input field
            const userInput = document.getElementById('user_id_input');
            if (userInput) {
                userInput.value = currentUserId.trim();
            }

            // Restore active view page on refresh
            restoreActivePage();
        });
    }

    // Listen for browser hash changes (Back/Forward arrows)
    window.addEventListener("hashchange", function () {
        restoreActivePage();
    });
</script>
