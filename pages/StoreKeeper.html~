<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changePasswordModalLabel"><i class="bi bi-shield-lock me-2"></i>Change Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="changePasswordForm">
                <div class="modal-body">

                    <!-- Password Requirements Instruction Block -->
                    <div class="alert alert-info py-2 px-3 mb-3 small border-0 bg-light-info text-dark rounded-3">
                        <div class="fw-bold mb-1 text-primary">
                            <i class="bi bi-info-circle me-1"></i> Password Requirements:
