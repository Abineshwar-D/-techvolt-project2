<script>
  function showpage(pageId) {
    // 1. Hide all pages
    document.querySelectorAll('.page').forEach(page => {
        page.style.display = "none";
    });

    // 2. Remove 'active' class from sidebar
    document.querySelectorAll('.sidebar .nav-item').forEach(item => {
        item.classList.remove('active');
    });

    // 3. Show selected page
    const page = document.getElementById(pageId);
    if (!page) return;
    page.style.display = (pageId === "logout") ? "flex" : "block";

     // 4. Update active sidebar item
    const activeNavItem = document.querySelector(`.sidebar .nav-item[onclick*="'${pageId}'"]`);
    if (activeNavItem) activeNavItem.classList.add('active');

    // 5. Automatically reload data & reset filters for Merchandising screens
    if (pageId === "page1" && typeof fetchKPIData === "function") {
        fetchKPIData(); // Dashboard
    } else if (pageId === "page3" && typeof loadOrdersAndKPIs === "function") {
        loadOrdersAndKPIs(); // Orders
    } else if (pageId === "page5" && typeof refreshAllData === "function") {
        refreshAllData(); // Purchase Orders
    } else if (pageId === "page4" && typeof loadSuppliersAndKPIs === "function") {
        loadSuppliersAndKPIs(); // Suppliers
    }

    // 5. Save current page
    if (pageId !== "logout") {
        window.location.hash = pageId;
        localStorage.setItem("activePage", pageId);
    }
}

function restoreActivePage() {
    let hashPage = window.location.hash.replace("#", "");
    if (!hashPage) {
        hashPage = localStorage.getItem("activePage") || "page1";
    }
    if (!document.getElementById(hashPage)) {
        hashPage = "page1";
    }
    showpage(hashPage);

    // Clear search on restore
    setTimeout(function () {
        const searchOrder = document.getElementById("searchOrder");
        if (searchOrder) searchOrder.value = "";
    }, 50);
}

    function getActiveUserId() {
        const urlParams = new URLSearchParams(window.location.search);

        const userId =
            urlParams.get("user_id") ||
            urlParams.get("admin_id") ||
            urlParams.get("id") ||
            localStorage.getItem("user_id") ||
            localStorage.getItem("admin_id") ||
            sessionStorage.getItem("user_id") ||
            sessionStorage.getItem("admin_id");

        if (userId && userId.trim() !== "" && userId !== "null" && userId !== "undefined") {
            return userId.trim();
        }
        return null;
    }

    // Session validation and page state restoration
    const currentUserId = getActiveUserId();

    if (!currentUserId || currentUserId.trim() === "" || currentUserId === "admin_id_input3") {
        alert("Session invalid or User ID missing. Please log in again.");
        window.location.href = "/techvoltInstituteProject/pages/login.html";
    } else {
        localStorage.setItem('user_id', currentUserId);
        sessionStorage.setItem('user_id', currentUserId);

        document.addEventListener("DOMContentLoaded", function () {
            // Populate form hidden input fields with user_id
            const inputIds = ['admin_id_input4'];
            inputIds.forEach(id => {
                const inputElem = document.getElementById(id);
                if (inputElem) {
                    inputElem.value = currentUserId.trim();
                }
            });

            // Restore active view page on refresh
            restoreActivePage();
        });
    }

    // Listen for browser hash changes (Back/Forward arrows)
    window.addEventListener("hashchange", function () {
        restoreActivePage();
    });
</script>
