import cgi
import json
import pymysql

print("Content-Type: application/json\n")

form = cgi.FieldStorage()
material_name = form.getvalue("material_name", "").strip()

stock = 0

if material_name:
    try:
        conn = pymysql.connect(
            host="localhost",
            user="root",
            password="",
            database="techvoltproject2"
        )
        cursor = conn.cursor()

        # Matches material name inside DB
        cursor.execute("""
            SELECT opening_stock 
            FROM materials 
            WHERE LOWER(material_name) LIKE LOWER(%s) AND status = 'Active'
            LIMIT 1
        """, (f"%{material_name}%",))

        row = cursor.fetchone()

        if row and row[0] is not None:
            stock = float(row[0])

        cursor.close()
        conn.close()
    except Exception as e:
        stock = 0

print(json.dumps({"stock": stock}))