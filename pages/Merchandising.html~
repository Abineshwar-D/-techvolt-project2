        <h2 class="fw-bold fs-2 text-dark mb-4">Create Purchase Order</h2>

        <div class="row g-4">
            <div class="col-xl-13">
                <div class="d-flex flex-column gap-3">
                    <div class="form-card">
                        <div class="card-header">
                            <i class="bi bi-cart-plus"></i>
                            <h5>Purchase Order Details</h5>
                        </div>
                        <div class="card-body">
                            <form id="poForm" method="post">

                                 <!-- Hidden input to store current user ID -->
                                 <input type="hidden" name="user_id" id="po_user_id">

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Supplier</label>
                                        <select class="form-select-custom" name="supplier_name" id="supplier" required>
                                            <option value="">Select Supplier</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Material</label>
                                        <select class="form-select-custom" name="material_name" id="material" required>
                                            <option value="">Select Material</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Available Stock(Inventory)</label>
                                        <input type="text" class="form-control-custom" value="" readonly name="available_stock" id="available_stock" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Required Quantity (Kg)</label>
                                        <input type="number" class="form-control-custom" value="" id="quantity" name="required_qty" required min="1" step="0.01">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label-custom">Expected Delivery Date</label>
                                        <input type="date" class="form-control-custom" value="" name="expected_delivery" id="expected_delivery" required>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <label class="form-label-custom">Remarks / Special Instructions</label>
                                    <textarea class="form-control-custom" rows="3" placeholder="Enter any specific requirements for this order..." name="remarks"></textarea>
                                </div>

                                <div class="d-flex flex-wrap gap-3 pt-3 mt-3 border-top">
                                    <button type="submit" class="btn-save">Save PO</button>
                                    <button type="button" class="btn-cancel">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

