def calculate_quotation(enq_data):
    fabric_base_price = 20.0
    color_price = (
        float(enq_data["price"]) if enq_data and enq_data.get("price") else 0.0
    )
    gsm_value = (
        float(enq_data["fabric_gsm"])
        if enq_data and enq_data.get("fabric_gsm")
        else 0.0
    )
    quantity = (
        float(enq_data["quantity"])
        if enq_data and enq_data.get("quantity")
        else 0.0
    )

    gsm_cost = gsm_value * 0.5
    unit_price = fabric_base_price + color_price + gsm_cost
    subtotal = unit_price * quantity
    gst_amount = subtotal * 0.18
    total_amount = subtotal + gst_amount

    return {
        "unit_price": unit_price,
        "subtotal": subtotal,
        "gst": gst_amount,
        "total": total_amount,
    }


