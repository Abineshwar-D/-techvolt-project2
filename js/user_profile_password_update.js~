/**
 * user_profile.js - Full Global User & Modal Handler
 */

// Helper: Extract active user_id from URL query string or LocalStorage
function getActiveUserId() {
    const urlParams = new URLSearchParams(window.location.search);
    const userId = urlParams.get("user_id") ||
                   urlParams.get("admin_id") ||
                   localStorage.getItem("user_id") ||
                   sessionStorage.getItem("user_id");
    return userId ? userId.trim() : null;
}

// 1. Fetch User Profile Data & Update Header DOM + Modal Inputs
function loadUserProfileHeader() {
    const userId = getActiveUserId();
    console.log("user_profile.js: Active User ID is ->", userId);

    if (!userId) {
        console.warn(" user_profile.js: User ID is missing in URL and LocalStorage!");
        return;
    }

    const pyUrl = `../py/getuserinformation/get_user_profile.py?action=fetch&user_id=${encodeURIComponent(userId)}`;
    console.log(" user_profile.js: Requesting URL ->", pyUrl);

    fetch(pyUrl)
        .then(res => res.json())
        .then(res => {
            console.log("user_profile.js: Backend Response ->", res);

            if (res.success && res.data) {
                const user = res.data;

                // 1. Header Name & Role
                const nameElem = document.getElementById("header-user-name");
                const roleElem = document.getElementById("header-user-role");
                if (nameElem) nameElem.textContent = user.fullname || user.employee_id;
                if (roleElem) roleElem.textContent = user.role || "";

                // 2. Dropdown User ID
                const dropdownUserElem = document.getElementById("header-dropdown-userid");
                if (dropdownUserElem) {
                    dropdownUserElem.textContent = user.employee_id || userId;
                    console.log(" Dropdown User ID set to:", dropdownUserElem.textContent);
                } else {
                    console.error(" Element #header-dropdown-userid not found in DOM!");
                }

                // 3. Change Password Modal Email Input
                const pwdEmailElem = document.getElementById("pwd_email");
                if (pwdEmailElem) {
                    pwdEmailElem.value = user.email || "No email found";
                    console.log(" Password Modal Email set to:", pwdEmailElem.value);
                } else {
                    console.error(" Element #pwd_email not found in DOM!");
                }

                // 4. Header Avatar Image
                const avatarImg = document.getElementById("header-user-avatar");
                if (avatarImg && user.profile_pic && user.profile_pic !== "null") {
                    avatarImg.src = user.profile_pic + "?t=" + new Date().getTime();
                }
            } else {
                console.error(" user_profile.js: Backend returned failure ->", res.message);
            }
        })
        .catch(err => {
            console.error(" user_profile.js: Fetch Error ->", err);
        });
}

// 2. Upload Profile Picture
window.uploadProfilePicture = function(input) {
    const userId = getActiveUserId();

    if (!input.files || !input.files[0]) {
        alert("Please select an image file.");
        return;
    }
    if (!userId) {
        alert("Session invalid. Please log in again.");
        return;
    }

    let formData = new FormData();
    formData.append("action", "upload_pic");
    formData.append("user_id", userId);
    formData.append("profile_pic", input.files[0]);

    fetch("../py/getuserinformation/get_user_profile.py", {
        method: "POST",
        body: formData
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            const avatarImg = document.getElementById("header-user-avatar");
            if (avatarImg) {
                avatarImg.src = data.image_url + "?t=" + new Date().getTime();
            }
        } else {
            alert("Upload Failed: " + data.message);
        }
    })
    .catch(err => {
        console.error("Upload error:", err);
        alert("Server error while uploading profile picture.");
    });
};

// 3. Auto-run on DOM Ready
document.addEventListener("DOMContentLoaded", function () {
    // Run Profile Fetch
    loadUserProfileHeader();

    // Attach File Upload Event Listener
    const fileInput = document.getElementById("profilePicInput");
    if (fileInput) {
        fileInput.addEventListener("change", function () {
            uploadProfilePicture(this);
        });
    }

    // Change Password Form Submission Handler
    const pwdForm = document.getElementById("changePasswordForm");
    if (pwdForm) {
        pwdForm.addEventListener("submit", function (e) {
            e.preventDefault();

            const userId = getActiveUserId();
            const newPwd = document.getElementById("pwd_new").value;
            const confirmPwd = document.getElementById("pwd_confirm").value;

            if (newPwd !== confirmPwd) {
                alert("New password and confirm password do not match!");
                return;
            }

            let formData = new FormData();
            formData.append("action", "change_password");
            formData.append("user_id", userId);
            formData.append("new_password", newPwd);

            fetch("../py/getuserinformation/get_user_profile.py", {
                method: "POST",
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);

                    const modalElem = document.getElementById('changePasswordModal');
                    if (modalElem && typeof bootstrap !== "undefined") {
                        const modal = bootstrap.Modal.getInstance(modalElem) || new bootstrap.Modal(modalElem);
                        modal.hide();
                    }

                    pwdForm.reset();
                } else {
                    alert("Error: " + data.message);
                }
            })
            .catch(err => console.error("Error changing password:", err));
        });
    }
});